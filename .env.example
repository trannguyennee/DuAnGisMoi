# Copy file này thành .env (đã được .gitignore) rồi điền giá trị thật.
# Tạo SECRET_KEY mới:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

DATABASE_URL=postgis://postgres:YOUR_PASSWORD@localhost:5432/gis

# Windows: thư mục bin của PostgreSQL có kèm GDAL/GEOS (mặc định bản 16)
# POSTGRES_BIN=C:\Program Files\PostgreSQL\18\bin
